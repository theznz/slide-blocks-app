{
  "name": "slide-blocks-app",
  "version": "1.0.0",
  "private": true,
  "description": "Sliding Block Puzzle - web game packaged for iOS and Android with Capacitor",
  "scripts": {
    "build": "python3 _design_screens/assemble.py && node scripts/build-www.js",
    "test": "node _design_screens/test_levels.js",
    "sync": "npm run build && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#171A36' --iconBackgroundColorDark '#171A36' --splashBackgroundColor '#0B0D1F' --splashBackgroundColorDark '#0B0D1F'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
